# Choose one provider. Gemini uses Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_MODEL=gemini-3.6-flash
LLM_MODEL=gemini-3.6-flash

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=hf_...
